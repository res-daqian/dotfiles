# Gruvbox Ghostty setup adapted from bruceblue-ghostty-config, tailored for Codex.
theme = Gruvbox Dark

# Maple Mono NF CN covers Latin, CJK, and Nerd Font glyphs for mixed-language terminals.
font-family = "Maple Mono NF CN"
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 12

background-opacity = 0.85
background-blur = true
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-save-state = always
cursor-style = bar

shell-integration = zsh
shell-integration-features = no-cursor,sudo,title,path
mouse-hide-while-typing = true
copy-on-select = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
confirm-close-surface = true
scrollback-limit = 10000000

macos-titlebar-style = transparent
macos-titlebar-proxy-icon = visible
macos-option-as-alt = true
quit-after-last-window-closed = true
initial-window = true

# Quick terminal and split-focused workflow for Codex.
quick-terminal-position = top
quick-terminal-animation-duration = 0.15
quick-terminal-autohide = true
quick-terminal-space-behavior = remain

keybind = super+shift+f=toggle_quick_terminal
